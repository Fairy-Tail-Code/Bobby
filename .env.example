GITEE_ACCESS_TOKEN=
GITEE_BASE_URL=

PLANNER_MODEL=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_TEMPERATURE=0.7

GENERATOR_MODEL=
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_TEMPERATURE=0.4

EVALUATOR_MODEL=
EVALUATOR_BASE_URL=
EVALUATOR_API_KEY=
EVALUATOR_TEMPERATURE=0.2

# HITL Email Configuration
# SMTP/IMAP设置用于设置系统邮箱地址，仅用于向其他人员收/发邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email_url
SMTP_PASSWORD=your_IMAP_PASSWORD
SMTP_USE_TLS=true

IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_email_url
IMAP_PASSWORD=your_IMAP_PASSWORD
IMAP_USE_SSL=true

# Per-role human operator email addresses
# 真正参与决策的任务的邮箱地址
HITL_PLANNER_EMAIL=your_email_url
HITL_GENERATOR_EMAIL=your_email_url
HITL_EVALUATOR_EMAIL=your_email_url
