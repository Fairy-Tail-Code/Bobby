GITEE_ACCESS_TOKEN=
GITEE_BASE_URL=

PM_MODEL=
PM_BASE_URL=
PM_API_KEY=
PM_TEMPERATURE=0.7

PLANNER_MODEL=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_TEMPERATURE=0.7

GENERATOR_MODEL=
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_TEMPERATURE=0.4

EVALUATOR_MODEL=
EVALUATOR_BASE_URL=
EVALUATOR_API_KEY=
EVALUATOR_TEMPERATURE=0.2

# HITL Email Configuration
# SMTP/IMAP设置用于设置系统邮箱地址，仅用于向其他人员收/发邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email_url
SMTP_PASSWORD=your_IMAP_PASSWORD
SMTP_USE_TLS=true

IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_email_url
IMAP_PASSWORD=your_IMAP_PASSWORD
IMAP_USE_SSL=true

# Per-role human operator email addresses
# 真正参与决策的任务的邮箱地址
HITL_PM_EMAIL=your_email_url
HITL_PLANNER_EMAIL=your_email_url
HITL_GENERATOR_EMAIL=your_email_url
HITL_EVALUATOR_EMAIL=your_email_url

# ============================================================
# HITL DingTalk Configuration (mode: dingtalk)
# 1. 创建企业内部应用: https://open-dev.dingtalk.com
# 2. 开启"机器人"能力，消息接收模式选"Stream"
# 3. 申请"企业内机器人发送消息"权限
# ============================================================
DINGTALK_CLIENT_ID=your_app_key
DINGTALK_CLIENT_SECRET=your_app_secret
DINGTALK_ROBOT_CODE=your_robot_code

# Per-role DingTalk userId (staffId)
HITL_PM_DINGTALK_USER_ID=
HITL_PLANNER_DINGTALK_USER_ID=
HITL_GENERATOR_DINGTALK_USER_ID=
HITL_EVALUATOR_DINGTALK_USER_ID=

# ============================================================
# HITL Feishu Configuration (mode: feishu)
# 1. 创建自建应用: https://open.feishu.cn
# 2. 开启"机器人"能力
# 3. 订阅事件: "接收消息 im.message.receive_v1"，模式选"长连接"
# 4. 申请权限: "im:message:send_as_bot"
# ============================================================
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# Per-role Feishu open_id
HITL_PM_FEISHU_OPEN_ID=
HITL_PLANNER_FEISHU_OPEN_ID=
HITL_GENERATOR_FEISHU_OPEN_ID=
HITL_EVALUATOR_FEISHU_OPEN_ID=
